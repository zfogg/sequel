prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: sequel-cxx
Description: C++ facade for the Sequel SQL library
Version: @PROJECT_VERSION@
Requires.private: sequel
Libs: -L${libdir} -lsequel_cxx
Cflags: -I${includedir}
