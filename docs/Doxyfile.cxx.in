PROJECT_NAME = "Sequel C++ API"
PROJECT_BRIEF = "C++2d ownership and expected facade for Sequel"
OUTPUT_DIRECTORY = "@DOCS_OUTPUT_DIR@/cxx"
INPUT = "@_docs_root@/cpp/include/sequel" "@_docs_root@/docs/cxx.md"
HTML_OUTPUT = .
GENERATE_HTML = YES
GENERATE_LATEX = NO
EXTRACT_ALL = YES
WARN_IF_UNDOCUMENTED = NO
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = YES
QUIET = YES
HAVE_DOT = NO
FULL_PATH_NAMES = NO
JAVADOC_AUTOBRIEF = YES
HTML_COLORSTYLE = AUTO_LIGHT
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
GENERATE_TREEVIEW = YES
